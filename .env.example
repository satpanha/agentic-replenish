# --- LLM (AMD Token Factory, OpenAI-compatible) ---
# Fill these from the lablab / AMD hackathon page. Leave LLM_API_KEY empty to run in offline mode.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Approval gate: only holders of this key can approve/reject purchase orders ---
APPROVER_KEY=demo-approver

# --- Data / storage ---
DATA_DIR=app/data_sample
DB_PATH=var/replenish.db

# --- Policy defaults ---
SERVICE_LEVEL=0.95
REVIEW_DAYS=7
EXCESS_COVER_DAYS=90
